# ── copie para .env (ao lado do docker-compose.yml) e ajuste ─────────────
# Domínio público usado nas etiquetas e nas mensagens (precisa de HTTPS)
PUBLIC_URL=https://quanto.leonnaviegas.dev.br

# 127.0.0.1 = só o reverse proxy alcança (recomendado)
# 0.0.0.0   = qualquer aparelho da rede alcança direto na porta
QUANTO_BIND=127.0.0.1
PORT=3030

SESSION_TTL_DAYS=90
INVITE_TTL_HOURS=24
MAX_MEMBERS=5
TZ=America/Sao_Paulo

# Caddy — reverse proxy do Quanto
#
# Caddy pega o certificado Let's Encrypt sozinho (porta 80 e 443 precisam estar
# liberadas no roteador). Trocar o domínio aqui e em PUBLIC_URL no compose.
#
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

quanto.leonnaviegas.dev.br {
	encode zstd gzip

	# o servidor escuta só em 127.0.0.1 (porta publicada pelo Docker)
	reverse_proxy 127.0.0.1:3030

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output file /var/log/caddy/quanto.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

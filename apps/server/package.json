{
  "name": "@quanto/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --include ../../packages/core/src --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "backup": "node scripts/backup.mjs",
    "check:deploy": "node scripts/check-deploy.mjs"
  },
  "dependencies": {
    "@quanto/core": "file:../../packages/core",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "zod": "^4.6.7",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.1",
    "@types/node": "^22.10.0",
    "typescript": "~6.0.3"
  }
}

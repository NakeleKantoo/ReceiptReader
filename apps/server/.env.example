# ── servidor ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3030
HOST=0.0.0.0

# caminho do SQLite (relativo a apps/server)
DATABASE_PATH=./data/quanto.db

# domínio público (usado em links de etiqueta QR)
PUBLIC_URL=https://quanto.leonnaviegas.dev.br

# sessão de cada aparelho
SESSION_TTL_DAYS=90

# convite de membro
INVITE_TTL_HOURS=24
MAX_MEMBERS=5

# 1 = está atrás de um reverse proxy (nginx/caddy/traefik)
TRUST_PROXY=1
